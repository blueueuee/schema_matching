{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Column Profile",
  "type": "object",
  "required": [
    "column_id",
    "raw_name",
    "normalized_tokens",
    "data_type",
    "sample_values",
    "name_embedding"
  ],
  "properties": {
    "column_id": {
      "type": "string"
    },
    "raw_name": {
      "type": "string"
    },
    "normalized_tokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_type": {
      "type": "string"
    },
    "sample_values": {
      "type": "array"
    },
    "name_embedding": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "value_profile": {
      "type": "object",
      "properties": {
        "dtype": { "type": "string" },
        "cardinality_ratio": { "type": "number" },
        "null_ratio": { "type": "number" },
        "length_stats": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "mean": { "type": "number" }
          }
        },
        "numeric_stats": {
          "type": ["object", "null"],
          "properties": {
            "mean": { "type": "number" },
            "std": { "type": "number" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "q25": { "type": "number" },
            "q50": { "type": "number" },
            "q75": { "type": "number" }
          }
        },
        "pattern_flags": {
          "type": "object",
          "properties": {
            "looks_like_email": { "type": "boolean" },
            "looks_like_phone": { "type": "boolean" },
            "looks_like_id_code": { "type": "boolean" },
            "looks_like_date_string": { "type": "boolean" }
          }
        }
      }
    }
  }
}